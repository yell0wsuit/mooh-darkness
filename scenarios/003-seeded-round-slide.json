{
    "formatVersion": 1,
    "name": "seeded round slide",
    "world": {
        "width": 5,
        "height": 5,
        "gravity": "Down",
        "randomSeed": 0,
        "entities": [
            {
                "alias": "round-body",
                "position": {
                    "x": 2,
                    "y": 1
                },
                "interactions": [],
                "gravityBody": {
                    "fallSpeed": 1,
                    "canSlide": true
                }
            },
            {
                "alias": "round-support",
                "position": {
                    "x": 2,
                    "y": 2
                },
                "interactions": [
                    "BlocksMovement",
                    "RoundSupport"
                ]
            }
        ]
    },
    "steps": [
        {
            "advanceMilliseconds": 250,
            "expectEvents": [
                {
                    "type": "SlideStarted",
                    "entity": "round-body",
                    "direction": "Left"
                }
            ]
        }
    ],
    "expectFinal": {
        "entities": [
            {
                "alias": "round-body",
                "position": {
                    "x": 1,
                    "y": 1
                },
                "motion": {
                    "cause": "Sliding",
                    "segmentDirection": "Left",
                    "travelSign": 1,
                    "speed": 1,
                    "progress": 0.25,
                    "resolutionOrder": 0
                }
            },
            {
                "alias": "round-support",
                "position": {
                    "x": 2,
                    "y": 2
                }
            }
        ]
    }
}
