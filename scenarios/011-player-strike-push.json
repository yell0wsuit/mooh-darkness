{
    "formatVersion": 1,
    "name": "player strike pushes an object until it is blocked",
    "world": {
        "width": 8,
        "height": 3,
        "gravity": "Down",
        "randomSeed": 0,
        "entities": [
            {
                "alias": "player",
                "position": {
                    "x": 1,
                    "y": 1
                },
                "interactions": [
                    "BlocksMovement"
                ],
                "playerBody": {
                    "moveSpeed": 2.5,
                    "pushSpeedMultiplier": 1.5,
                    "facingDirection": "Right"
                }
            },
            {
                "alias": "rock",
                "position": {
                    "x": 2,
                    "y": 1
                },
                "interactions": [
                    "BlocksMovement",
                    "PlayerPushable"
                ]
            },
            {
                "alias": "wall",
                "position": {
                    "x": 5,
                    "y": 1
                },
                "interactions": [
                    "BlocksMovement"
                ]
            }
        ]
    },
    "steps": [
        {
            "input": [
                "Fire"
            ],
            "advanceMilliseconds": 1,
            "expectEvents": [
                {
                    "type": "PlayerStrikeStarted",
                    "entity": "player",
                    "direction": "Right",
                    "durationMilliseconds": 150
                }
            ]
        },
        {
            "input": [
                "Fire"
            ],
            "advanceMilliseconds": 199,
            "expectEvents": [
                {
                    "type": "PlayerStruck",
                    "entity": "player",
                    "direction": "Right",
                    "position": {
                        "x": 2,
                        "y": 1
                    }
                },
                {
                    "type": "PushStarted",
                    "entity": "rock",
                    "direction": "Right"
                }
            ]
        },
        {
            "input": [
                "Fire"
            ],
            "advanceMilliseconds": 800,
            "expectEvents": [
                {
                    "type": "CellEntered",
                    "entity": "rock",
                    "position": {
                        "x": 3,
                        "y": 1
                    }
                },
                {
                    "type": "PushStarted",
                    "entity": "rock",
                    "direction": "Right"
                },
                {
                    "type": "CellEntered",
                    "entity": "rock",
                    "position": {
                        "x": 4,
                        "y": 1
                    }
                },
                {
                    "type": "StrikePushStopped",
                    "entity": "rock",
                    "direction": "Right"
                }
            ]
        }
    ],
    "expectFinal": {
        "entities": [
            {
                "alias": "player",
                "position": {
                    "x": 1,
                    "y": 1
                },
                "facingDirection": "Right",
                "playerReaction": "Normal",
                "reactionMilliseconds": 0
            },
            {
                "alias": "rock",
                "position": {
                    "x": 4,
                    "y": 1
                }
            },
            {
                "alias": "wall",
                "position": {
                    "x": 5,
                    "y": 1
                }
            }
        ]
    }
}
