    "expectFinal": {
        "entities": [
            {
                "alias": "blue",
                "position": { "x": 1, "y": 0 },
                "motion": {
                    "cause": "MonsterWalking",
                    "segmentDirection": "Up",
                    "travelSign": 1,
                    "speed": 1.5625,
                    "progress": 0,
                    "resolutionOrder": 0
                },
                "blueMonsterState": "Walking",
                "blueMonsterFacingDirection": "Up",
