<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Mooh.Presentation/Mooh.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../assets/sprites/*.png"
             Link="assets/sprites/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/sprites/*.seq"
             Link="assets/sprites/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/fonts/*.fnt"
             Link="assets/fonts/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/text/strings.bin"
             Link="assets/text/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/music/TrackMenu.skm;../../assets/music/Music.ini"
             Link="assets/music/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/sounds/Sound.ini"
             Link="assets/sounds/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/animations/*.json"
             Link="assets/animations/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/levels/**/*.json"
             Link="assets/levels/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
