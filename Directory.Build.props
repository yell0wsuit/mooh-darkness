<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTestProjectName>$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))</IsTestProjectName>
    <IsAotCompatible Condition="'$(IsTestProjectName)' != 'True'">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>dirty</VersionSuffix>
    <Company>yell0wsuit</Company>
    <Product>Mooh</Product>
    <Description>A rewrite of the 2007 puzzle game Crazy Chicken: Jewel of Darknewss.</Description>
    <Copyright>Copyright © 2026 yell0wsuit</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>
</Project>
